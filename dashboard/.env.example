# Everything here is optional.

# Organization name shown in the top bar.
VITE_ORG_NAME=Your organization

# Only set this if the dashboard can't use the Vite dev proxy (vite.config.ts
# forwards /v1 to http://127.0.0.1:8001). When set, the server's
# DASHBOARD_ORIGINS must include the dashboard's own address.
# VITE_API_BASE=http://127.0.0.1:8001
